# Copy this file to deploy/deploy.env and edit. Sourced by deploy.sh,
# rollback.sh and their matching make targets; gitignored so it stays
# personal.

# Required: SSH target. Either a bare hostname (defaults to root@<host>)
# or an explicit user@host.
DEPLOY_HOST=server.example.com

# Optional absolute paths. Values are forwarded to a remote root shell and
# therefore accept only letters, digits, slash, dot, underscore, plus and
# hyphen. LOCK_FILE must match scripts/run-cron.sh on the target.
# INSTALL_DIR=/opt/logwatch-ai
# LOCK_FILE=/run/logwatch-ai-cron.lock
