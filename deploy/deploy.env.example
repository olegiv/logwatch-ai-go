# Copy this file to deploy/deploy.env and edit. Sourced by the deploy/
# scripts (preflight.sh, deploy.sh, rollback.sh, status.sh) and by the
# matching make targets; gitignored so it stays personal.

# Required: SSH target. Either a bare hostname (defaults to root@<host>)
# or an explicit user@host.
DEPLOY_HOST=server.example.com
