{
  "version": "1.0",
  "default_site": "production",
  "sites": {
    "production": {
      "name": "Production Site",
      "legacy_names": ["Production Website"],
      "drupal_root": "/var/www/production/drupal",
      "system_user": "www-data",
      "watchdog_path": "/var/log/logwatch-ai/production-watchdog.json",
      "watchdog_format": "json",
      "min_severity": 4,
      "watchdog_limit": 100
    },
    "staging": {
      "name": "Staging Site",
      "drupal_root": "/var/www/staging/drupal",
      "system_user": "www-data",
      "watchdog_path": "/var/log/logwatch-ai/staging-watchdog.json",
      "watchdog_format": "json",
      "min_severity": 4,
      "watchdog_limit": 200
    },
    "dev": {
      "name": "Development Site",
      "drupal_root": "/var/www/dev/drupal",
      "system_user": "www-data",
      "watchdog_path": "/var/log/logwatch-ai/dev-watchdog.json",
      "watchdog_format": "json",
      "min_severity": 5,
      "watchdog_limit": 500
    }
  }
}
